# Development examples only. Copy to .env; never commit the real .env.
APP_NAME=GovReach AI
APP_ENV=development
APP_DEBUG=true
DATABASE_URL=postgresql+psycopg://govreach:govreach_password@localhost:5432/govreach
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-random-development-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=90
OPENAI_API_KEY=
# Local media bytes are stored under data/media by default (ignored by Git).
MEDIA_MAX_BYTES=10485760
